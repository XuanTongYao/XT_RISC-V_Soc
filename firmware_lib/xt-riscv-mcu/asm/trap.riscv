.section .init.trap,"ax",@progbits
    # 初始化 中断向量
    lla a0, __TRAP_VECTOR__
    ori a0, a0, 1
    csrw mtvec, a0
    # 关闭所有中断
    csrw mie, x0

# 异常/中断向量表
.section .trap.vector,"ax",@progbits
_exception:
    j Exception_Handler
_software_int:
    j ssoftware_IRQ_Handler # 未实现S模式
    .space 4
    j msoftware_IRQ_Handler
    .space 4
_timer_int:
    j stimer_IRQ_Handler # 未实现S模式
    .space 4
    j mtimer_IRQ_Handler
    .space 4
_extern_int: # 外部中断由外部中断控制器重定向到自定义中断
    j sextern_IRQ_Handler # 未实现S模式
    .space 4
    j mextern_IRQ_Handler # 由硬件重定向
    .space 4
    nop
    nop
    nop
# 自定义中断中断号16开始，对应外部中断的0号中断
_custom_int:
    j UART_RX_IRQ_Handler
    mret # 保留
    mret
    mret
    mret
    mret
    mret
    mret
    j I2C1_IRQ_Handler
    j I2C2_IRQ_Handler
    j SPI_IRQ_Handler
    j Timer_IRQ_Handler
    j WBC_UFM_IRQ_Handler


# 弃置的自陷处理函数
.section .trap.delete_handler,"ax",@progbits
.global delete_IRQ_handler
.global UnhandledFault
# 未实现的中断处理函数死循环 没办法清空待处理中断位 应该死循环
delete_IRQ_handler:
    j delete_IRQ_handler

# 未处理错误死循环
UnhandledFault:
    j UnhandledFault


