.section .init.trap,"ax",@progbits
    # 初始化 中断向量
    lla a0, _vector_table
    ori a0, a0, 1
    csrw mtvec, a0
    # 关闭所有中断
    csrw mie, x0

# 异常/中断向量表
.section .trap.vector,"ax",@progbits
.global _vector_table
_vector_table:
_exception:
        j Exception_Handler
_software_int:
    j DefaultHandler
    j DefaultHandler
        j msoftware_IRQ_Handler
    j DefaultHandler
_timer_int:
    j DefaultHandler
    j DefaultHandler
        j mtimer_IRQ_Handler
    j DefaultHandler
_extern_int: # 外部中断由外部中断控制器重定向到自定义中断
    .rept 7
    j DefaultHandler
    .endr
# 自定义中断中断号16开始，对应外部中断的0号中断
_custom_int:
        j UartRx_IRQ_Handler
    # 保留
    .rept 7
    j DefaultHandler
    .endr
        j I2c1_IRQ_Handler
        j I2c2_IRQ_Handler
        j Spi_IRQ_Handler
        j Timer_IRQ_Handler
        j WbcUfm_IRQ_Handler


# 未实现的中断处理函数 无法清空待处理中断位 应该死循环
# 未处理的异常也应该死循环
# 调试器可以自己读取mcause查看故障原因
.section .trap.default_handler,"ax",@progbits
.global AbortHalt
.global abort
AbortHalt:
abort:
    j abort


